<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.europa.ec.leos</groupId>
        <artifactId>repository</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>eu.europa.ec.leos.repository</groupId>
    <artifactId>repository-config</artifactId>
    <packaging>pom</packaging>

    <name>LEOS Repository Config</name>
    <description>LEOS Repository Config Module</description>

    <properties>
        <project.output.directory>target/generated-config</project.output.directory>
    </properties>

    <dependencies>
        <!--Logging frameworks -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Security framework -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>
    </dependencies>


    <profiles>
        <!-- OS Instance -->
        <profile>
            <id>instance-default</id>
            <activation>
                <property>
                    <name>!instance</name>
                </property>
            </activation>
            <properties>
                <leos.build.instance>os</leos.build.instance>
            </properties>
        </profile>
        <!-- EC Instance -->
        <profile>
            <id>instance-ec</id>
            <activation>
                <property>
                    <name>instance</name>
                    <value>ec</value>
                </property>
            </activation>
            <properties>
                <leos.build.instance>ec</leos.build.instance>
            </properties>
        </profile>
        <!-- CN Instance -->
        <profile>
            <id>instance-cn</id>
            <activation>
                <property>
                    <name>instance</name>
                    <value>cn</value>
                </property>
            </activation>
            <properties>
                <leos.build.instance>cn</leos.build.instance>
            </properties>
        </profile>
        <profile>
            <id>env-default</id>
            <activation>
                <property>
                    <name>!env</name>
                </property>
            </activation>
            <properties>
                <leos.build.env>local</leos.build.env>
            </properties>
        </profile>
        <profile>
            <id>env</id>
            <activation>
                <property>
                    <name>env</name>
                </property>
            </activation>
            <properties>
                <leos.build.env>local</leos.build.env>
            </properties>
        </profile>
        <profile>
            <id>specific-env-config-files</id>
            <activation>
                <property>
                    <name>env</name>
                    <value>!all</value>
                </property>
            </activation>
            <build>
                <plugins>

                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <filters>
            <filter>src/etc/filters/common.properties</filter>
            <filter>src/etc/filters/${leos.build.instance}/${leos.build.env}.properties</filter>
        </filters>
        <plugins>
            <!-- CLEAN -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-resources-common</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.output.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <!-- Filtered resource files. -->
                                    <filtering>true</filtering>
                                    <directory>src/etc/resources</directory>
                                    <includes>
                                        <include>*.properties</include>
                                        <include>*.xml</include>
                                        <include>*.wsdl</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <!-- Filtered resource files per instance. -->
                                    <filtering>true</filtering>
                                    <directory>src/etc/resources/${leos.build.instance}</directory>
                                    <includes>
                                        <include>*.properties</include>
                                        <include>*.xml</include>
                                        <include>*.wsdl</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.coderplus.maven.plugins</groupId>
                <artifactId>copy-rename-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rename-file</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>rename</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <sourceFile>${project.output.directory}/application.properties</sourceFile>
                                    <destinationFile>${project.output.directory}/leos-repository.properties</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>${project.output.directory}/application-h2.properties</sourceFile>
                                    <destinationFile>${project.output.directory}/leos-repository-h2.properties</destinationFile>
                                </fileSet>
                                <fileSet>
                                    <sourceFile>${project.output.directory}/application-oracle.properties</sourceFile>
                                    <destinationFile>${project.output.directory}/leos-repository-oracle.properties</destinationFile>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-install</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <extensions>
            <!-- Enabling the use of FTP for deployment -->
            <extension>
                <groupId>org.apache.maven.wagon</groupId>
                <artifactId>wagon-ftp</artifactId>
                <version>${wagon-ftp-extension.version}</version>
            </extension>
        </extensions>
    </build>
</project>
