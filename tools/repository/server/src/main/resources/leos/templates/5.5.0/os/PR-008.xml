<?xml version="1.0" encoding="utf-8" standalone="no"?>
<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:leos="urn:eu:europa:ec:leos" xmlns:xml="http://www.w3.org/XML/1998/namespace">
    <documentCollection name="ACT_AUTO_COM">
        <meta>
            <identification source="~COM">
                <FRBRWork>
                    <FRBRthis value=""/>
                    <FRBRuri value=""/>
                    <FRBRalias value="" name=""/>
                    <FRBRdate date="2999-01-01" name=""/>
                    <FRBRauthor href=""/>
                    <preservation xmlns:akn4eu="http://imfc.europa.eu/akn4eu">
                        <akn4eu:fileCUID value="xxxxxxxx"/>
                        <akn4eu:docCUID value="yyyyyyyyy"/>
                    </preservation>
                    <FRBRcountry value="EU"/>
                    <FRBRprescriptive value="false"/>
                </FRBRWork>
                <FRBRExpression>
                    <FRBRthis value=""/>
                    <FRBRuri value=""/>
                    <FRBRdate date="2999-01-01" name=""/>
                    <FRBRauthor href=""/>
                    <FRBRlanguage language="{{language}}"
                     xml:id="FRBRlanguage"/>
                </FRBRExpression>
                <FRBRManifestation>
                    <FRBRthis value=""/>
                    <FRBRuri value=""/>
                    <FRBRdate date="2999-01-01" name=""/>
                    <FRBRauthor href=""/>
					<preservation xmlns:akn4eu="http://imfc.europa.eu/akn4eu">
                		<akn4eu:akn4euVersion value="5.0.0.0"/>
						<akn4eu:akn4euDocumentation href="https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/akn4eu"/>
                	</preservation>
                </FRBRManifestation>
            </identification>
            <references source="~COM">
                <TLCLocation xml:id="BEL_BRU" href="http://publications.europa.eu/resource/authority/place/BEL_BRU" showAs="Brussels"/>
                <TLCOrganization xml:id="COM" href="http://publications.europa.eu/resource/authority/corporate-body/COM" showAs="European Commission"/>
                <TLCReference xml:id="ACT_AUTO_COM" href="http://publications.europa.eu/resource/authority/resource-type/ACT_AUTO_COM" name="docType" showAs="Commission autonomous act"/>
                <TLCReference xml:id="EXPL_MEMORANDUM" href="http://publications.europa.eu/resource/authority/resource-type/EXPL_MEMORANDUM" name="docType" showAs="Explanatory memorandum"/>
                <TLCReference xml:id="DIR_IMPL" href="http://publications.europa.eu/resource/authority/resource-type/DIR_IMPL" name="docType" showAs="Implementing directive"/>
                <TLCReference xml:id="language" href="http://publications.europa.eu/resource/authority/language/{{language3}}" name="language" showAs="{{language}}"/>
            </references>
            <proprietary source="~COM">
                <leos:templateVersion>1.0.0</leos:templateVersion>
                <leos:docVersion>0.1.0</leos:docVersion>
                <leos:template>SJ-008</leos:template>
                <leos:docTemplate>PR-008</leos:docTemplate>
            </proprietary>
        </meta>
        <coverPage>
            <container name="logo">
                <p>
                    <img src="data:image/png;base64,"
                         alt="European Commission" title="European Commission"/>
                </p>
            </container>
            <container name="actingEntity">
                <p><organization refersTo="~COM">{{pr.org}}</organization></p>
            </container>
            <container name="mainDoc">
                <block name="placeAndDate">
                    <location refersTo="~BEL_BRU">{{location}}</location>, <date class="template" date="2999-01-01"/>
                </block>
                <block name="reference" class="template">
                    <docNumber class="template"/>
                </block>
            </container>
            <longTitle>
                <p>
                    <docType refersTo="~DIR_IMPL">{{docType.008}}</docType>{{pr.afterDocType}}<date date="2999-01-01">{{dateContent}}</date>
                    <docPurpose  leos:editable="true" leos:deletable="false">{{docPurpose}}</docPurpose>
                </p>
            </longTitle>
            <container class="template" name="associatedReferences">
				<p/>
			</container>
            <container name="mainDocLanguage">
                <p><inline name="language" refersTo="~FRBRlanguage">{{languageUpper}}</inline></p>
            </container>
        </coverPage>
        <collectionBody/>
    </documentCollection>
</akomaNtoso>