        <item type="CATEGORY" id="c2.1" enabled="true" key="DELEGATED_AUTONOMOUS_ACTS">
            <names>
                <name lang="EN">Delegated Acts (article 290 TFEU)</name>
                <name lang="FR">Actes délégués (article 290 TFUE)</name>
            </names>
            <item type="CATEGORY" id="c2.1.1" enabled="true" key="COMMISSION_DELEGATED_DECISION">
                <names>
                    <name lang="EN">Commission delegated Decision</name>
                    <name lang="FR">Décision déléguée de la Commission</name>
                </names>
                <descriptions>
                    <description lang="EN">Delegated Commission decisions are adopted following a delegation given by the legislator in the basic act (art. 290 TFUE). They take effect upon their publication in the Official Journal of the European Union or upon notification to their destinataries. Do not forget to check the relevant box in the tab "Destination - Actes autonomes"</description>
                    <description lang="FR">Les décisions déléguées de la Commission sont adoptées suite à une délégation donnée par le législateur dans l'acte de base (art. 290 TFUE). Elles entrent en vigueur soit par leur publication au Journal officiel de l'Union européenne soit par leur notification aux destinataires. N'oubliez pas de cocher la case correspondante dans l'onglet "Destination" - "Actes autonomes"</description>
                </descriptions>
            </item>
        </item>
