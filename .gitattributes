# Set default to normalize and convert to native line endings on checkout.
* text=auto

# Declare files that will always have CRLF line endings on checkout.
*.bat   text eol=crlf

# Declare files that will always have LF line endings on checkout.
*.sh    text eol=lf

# Declare files that are truly binary and should not be modified.
*.doc   binary
*.docx  binary
*.eap   binary
*.eot   binary
*.gif   binary
*.ico   binary
*.jpg   binary
*.pdf   binary
*.png   binary
*.swf   binary
*.ttf   binary
*.woff  binary
*.xls   binary
*.xlsx  binary

# -----------------------------------------------------------------------
# Greek fork: upstream paths that Greece will never use.
# On conflict, always keep our version (deleted or replaced).
# -----------------------------------------------------------------------

# EU/EC-specific document templates — Greece will have its own gr/ tree
tools/repository/server/src/main/resources/leos/templates/**/ec/** merge=ours
tools/repository/server/src/main/resources/leos/templates/**/os/** merge=ours

# DECIDE / ISC integration — EU institution workflow, not relevant for Greece
modules/integration/**                                                 merge=ours
