{
  "name": "test-cypress",
  "version": "1.0.0",
  "description": "test edit application using cypress",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cy:generateReport": "node .\\cucumberReport.js",
    "cy:open": "npx cypress open",
    "cy:run": "npx cypress run --browser chrome --headed"
  },
  "author": "Satyabrata Das",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "@cucumber/cucumber": "^12.2.0",
    "@cypress/xpath": "^2.0.3",
    "cucumber-html-reporter": "^7.1.1",
    "cypress": "^15.1.0",
    "cypress-cucumber-attach-screenshots-to-failed-steps": "^1.0.0",
    "cypress-real-events": "^1.15.0",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.25.9",
    "multiple-cucumber-html-reporter": "^3.9.3"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.js",
    "json": {
      "enabled": true,
      "output": "cypress/report/cucumber-report.json"
    }
  },
  "dependencies": {
    "decompress": "^4.2.1",
    "form-data": "^4.0.4",
    "fs": "^0.0.1-security"
  }
}
