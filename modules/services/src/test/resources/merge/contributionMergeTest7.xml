            <citations leos:editable="false" leos:origin="ec" xml:id="ecfnMj79boazMa0gW">
                <citation leos:editable="true" leos:origin="ec" refersTo="~legalBasis" xml:id="ecfBM5utmN2ehc2xq">
                    <p leos:origin="ec" xml:id="ec0PgtBx9KOkyjk0A">Having regard to the Treaty on the Functioning of the European Union, and in particular Article [...] thereof,</p>
                </citation>
                <citation leos:editable="true" leos:origin="ec" xml:id="ecR42mRlIKxVlfgsY">
                    <p leos:origin="ec" xml:id="ec7BU7ozGflGHwVD8">Having regard to the proposal from the European Commission,</p>
                </citation>
                <citation leos:editable="true" leos:origin="ec" xml:id="ecPqP3llYs5NNbcUC">
                    <p leos:origin="ec" xml:id="ecnvQUZn7WqN4QYnr">After transmission of the draft legislative act to the national Parliaments,</p>
                </citation>
                <citation leos:editable="true" leos:origin="ec" xml:id="ecA6wtsFdslcSndGJ">
                    <p leos:origin="ec" xml:id="ecdZYFP1ifmTZ25dB">Having regard to the opinion of the European Economic and Social Committee<authorialNote leos:origin="ec" marker="(1)" placement="bottom" xml:id="ec5Zo8NmDy6OmkT6Q"><p leos:origin="ec" xml:id="ecGenSjB7VFy3BIT2">OJ C [...], [...], p. [...]</p></authorialNote>,</p>
                </citation>
                <citation leos:editable="true" leos:origin="ec" xml:id="ecaK0xvQ1sd89Py1o">
                    <p leos:origin="ec" xml:id="ecKo9GF3rNQ5w8yaF">Having regard to the opinion of the Committee of the Regions<authorialNote leos:origin="ec" marker="(2)" placement="bottom" xml:id="ecss5aqgnpPuY2tMD"><p leos:origin="ec" xml:id="ecoiaVJ0j5RgjTd01">OJ C [...], [...], p. [...]</p></authorialNote>,</p>
                </citation>
                <citation leos:editable="true" leos:origin="ec" xml:id="ecxZiS17eizIbxACY">
                    <p leos:origin="ec" xml:id="ecBtgVzenhl0JlBfg">Acting in accordance with the ordinary legislative procedure,</p>
                </citation>
