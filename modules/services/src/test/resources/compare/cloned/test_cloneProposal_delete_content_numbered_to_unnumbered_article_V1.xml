<article leos:origin="ec" xml:id="_bill__akn_article_sUTiiX">
    <num leos:editable="false" leos:origin="ec" xml:id="akn_article_yXTDOu_UQtTnl">Article 6</num>
    <heading leos:origin="ec" xml:id="akn_article_yXTDOu_uV2Usl">National stage of the procedure of registration 
    </heading>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu_sEVohD">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_mGqPHE">1.</num>
        <content leos:origin="ec" xml:id="akn_article_yXTDOu_bwOhzU">
            <p leos:origin="ec" xml:id="akn_article_yXTDOu_1fr2Y9">An application for the registration of a geographical
                indication concerning a product originating in the Union shall be addressed to the competent authorities
                of the Member State in which the product originates.
            </p>
        </content>
    </paragraph>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu_7mxkEi">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_5jJjnV">2.</num>
        <list leos:origin="ec" xml:id="akn_article_yXTDOu_PPwwf8">
            <subparagraph leos:origin="ec" xml:id="akn_article_yXTDOu_FfSrEo">
                <content leos:origin="ec" xml:id="akn_article_yXTDOu_pIDOM6">
                    <p leos:origin="ec" xml:id="akn_article_yXTDOu_zUaH9C">The application referred to in shall
                        <mref leos:origin="ec" xml:id="_bill__akn_article_sUTiiX_gw7aSR">paragraph
                            <ref href="REG-cldoemxke000mx05815hudwp1-en/akn_article_yXTDOu_sEVohD" leos:origin="ec"
                                 xml:id="_bill__akn_article_sUTiiX_7FwtLv">(1)
                            </ref>
                        </mref>
                        comprise:
                    </p>
                </content>
            </subparagraph>
            <point leos:origin="ec" xml:id="akn_article_yXTDOu_vCsEB9">
                <num leos:origin="ec" xml:id="akn_article_yXTDOu_SWsatr">(a)</num>
                <content leos:origin="ec" xml:id="akn_article_yXTDOu_aw51wF">
                    <p leos:origin="ec" xml:id="akn_article_yXTDOu_JhCKwD">the product specification provided for in
                        <mref leos:origin="ec" xml:id="_bill__akn_article_sUTiiX_1Hqrd6">Article
                            <ref href="REG-cldoemxke000mx05815hudwp1-en/_art_1" leos:origin="ec"
                                 xml:id="_bill__akn_article_sUTiiX_wkCT3u">1
                            </ref>
                        </mref>
                        ;
                    </p>
                </content>
            </point>
            <point leos:origin="ec" xml:id="akn_article_yXTDOu_sUUDDD" leos:softuser="DOE Jane(DGT)"
                   leos:softdate="2023-02-03T16:52:26+01:00">
                <num leos:origin="ec" xml:id="akn_article_yXTDOu_QV1OHC">(b)</num>
                <content leos:origin="ec" xml:id="akn_article_yXTDOu_WYmhLu">
                    <p leos:origin="ec" xml:id="akn_article_yXTDOu_cTPGKZ">the single document provided for in
                        <mref leos:origin="ec" xml:id="_bill__akn_article_sUTiiX_bIsLJf">Article
                            <ref href="REG-cldoemxke000mx05815hudwp1-en/__akn_article_xSoDxn" leos:origin="ec"
                                 xml:id="_bill__akn_article_sUTiiX_9PPaSV">4
                            </ref>
                        </mref>
                        ;
                    </p>
                </content>
            </point>
        </list>
    </paragraph>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu_tq31ro">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_a3N4iy">3.</num>
        <content leos:origin="ec" xml:id="akn_article_yXTDOu_fkSUV1">
            <p leos:origin="ec" xml:id="akn_article_yXTDOu_DHH66j">The Member State shall scrutinise the application for
                registration in order to check that it meets the conditions for registration of the respective
                provisions for wine, spirit drinks or agricultural products as appropriate.
            </p>
        </content>
    </paragraph>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu_UUTgyi" leos:softuser="DOE Jane(DGT)"
               leos:softdate="2023-02-03T16:52:31+01:00">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_RFzOrF">4.</num>
        <content leos:origin="ec" xml:id="akn_article_yXTDOu_vVQtf3">
            <p leos:origin="ec" xml:id="akn_article_yXTDOu_s6g6BY">As part of the scrutiny referred to in
                <mref leos:origin="ec" xml:id="_bill__akn_article_sUTiiX_qsdrVd">Article
                    <ref href="REG-cldoemxke000mx05815hudwp1-en/_art_definitions" leos:origin="ec"
                         xml:id="_bill__akn_article_sUTiiX_zc5ikq">3
                    </ref>
                </mref>
                , the Member State shall conduct a national opposition procedure. The national opposition procedure
                shall ensure publication of the application for registration and provide for a period of at least
                2 months from the date of publication within which any natural or legal person having a legitimate
                interest and established or resident on the territory of the Member State in which the product concerned
                originates may lodge an opposition to the application for registration with that Member State.
            </p>
        </content>
    </paragraph>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu_wHIkBE">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_46p1O8">5.</num>
        <content leos:origin="ec" xml:id="akn_article_yXTDOu_ABaZbx">
            <p leos:origin="ec" xml:id="akn_article_yXTDOu_Enh50Z">If, after the scrutiny of the application for
                registration and the assessment of the results of any opposition received and any changes to the
                application agreed with the applicant producer group, the Member State considers that the requirements
                of this Regulation are met, it may take a favourable decision and lodge a Union application as referred
                to in.
            </p>
        </content>
    </paragraph>
    <paragraph leos:origin="ec" xml:id="akn_article_yXTDOu-par1">
        <num leos:origin="ec" xml:id="deleted_akn_article_yXTDOu_cE04mj">6.</num>
        <content leos:origin="ec" xml:id="akn_article_yXTDOu_RW8bYZ">
            <p leos:origin="ec" xml:id="akn_article_yXTDOu_6f36WK">The Member State shall ensure that its decision, be
                it favourable or not, is made public and that any natural or legal person having a legitimate interest
                has an opportunity to lodge an appeal. The Member State shall also ensure that the product specification
                on which its favourable decision is based is published, and shall provide electronic access to the
                product specification.
            </p>
        </content>
    </paragraph>
</article>