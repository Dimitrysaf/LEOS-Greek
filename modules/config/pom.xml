<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.europa.ec.leos.pilot</groupId>
        <artifactId>leos-modules</artifactId>
        <version>5.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>leos-config</artifactId>
    <packaging>jar</packaging>

    <name>Config</name>
    <description>LEOS Config Module</description>

    <properties>
        <project.output.directory>target/generated-config</project.output.directory>
    </properties>

    <dependencies>
        <!--Logging frameworks -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Security framework -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>
    </dependencies>

    <build>
        <filters>
            <filter>src/etc/config/filters/common.properties</filter>
            <filter>src/etc/config/filters/${leos.build.instance}/${leos.build.env}.properties</filter>
        </filters>
        <plugins>
            <!-- CLEAN -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-resources-common</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.output.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <!-- Filtered resource files. -->
                                    <filtering>true</filtering>
                                    <directory>src/etc/config/resources</directory>
                                    <includes>
                                        <include>*.properties</include>
                                        <include>*.xml</include>
                                        <include>*.wsdl</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <!-- Filtered resource files per instance. -->
                                    <filtering>true</filtering>
                                    <directory>src/etc/config/resources/${leos.build.instance}</directory>
                                    <includes>
                                        <include>*.properties</include>
                                        <include>*.xml</include>
                                        <include>*.wsdl</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rename-file</id>
                        <!-- You can keep process-resources, or go back to compile; both are fine
                             as long as resources have already run. With process-resources and the
                             plugin order you have, it's OK. -->
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- application.properties -> application_leos.properties -->
                                <move
                                        file="${project.output.directory}/application.properties"
                                        tofile="${project.output.directory}/application_leos.properties"
                                        overwrite="true" />

                                <!-- integration.properties -> integration_leos.properties -->
                                <move
                                        file="${project.output.directory}/integration.properties"
                                        tofile="${project.output.directory}/integration_leos.properties"
                                        overwrite="true" />

                                <!-- message.properties -> message_leos.properties -->
                                <move
                                        file="${project.output.directory}/message.properties"
                                        tofile="${project.output.directory}/message_leos.properties"
                                        overwrite="true" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <extensions>
            <!-- Enabling the use of FTP for deployment -->
            <extension>
                <groupId>org.apache.maven.wagon</groupId>
                <artifactId>wagon-ftp</artifactId>
                <version>${wagon-ftp-extension.version}</version>
            </extension>
        </extensions>
    </build>
</project>
