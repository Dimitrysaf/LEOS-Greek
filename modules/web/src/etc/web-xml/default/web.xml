<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1" id="LeosWebModuleID">

    <display-name>${project.description}</display-name>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>5</session-timeout>
        <!-- session timeout should always be more then double of heartbeat  -->
    </session-config>

    <!-- User authentication -->
    <login-config>
        <auth-method>${leos.web.auth.method}</auth-method>
    </login-config>

    <!-- User access privileges -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Secure</web-resource-name>
            <description>Require users to authenticate</description>
            <url-pattern>/ui/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description>Allow access to authenticated users</description>
            <role-name>**</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description>Encryption is not required</description>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>UnSecure</web-resource-name>
            <description>Not require users to authenticate</description>
            <url-pattern>/ui/api/*</url-pattern>
        </web-resource-collection>
    </security-constraint>
</web-app>
